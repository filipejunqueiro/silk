{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "types": ["@types/node", "@citizenfx/server"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    }
  }
}
