{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "types": ["@types/node", "@citizenfx/server"],
    "baseUrl": ".",
    "outDir": ".",
  },
  "include": ["Silk.ts"],
  "exclude": ["**/node_modules"],
}
